# App
PORT=3001
API_PREFIX=api/v1
CORS_ORIGINS=*

# Database
# Local default: localhost
# Docker default: docker-compose overrides MYSQL_HOST to mysql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=chatuser
MYSQL_PASS=chatpass
MYSQL_DB=chatdb
MYSQL_ROOT_PASSWORD=rootpass
DB_SYNCHRONIZE=false
MYSQL_LOGGING=false
DB_WAIT_TIMEOUT_SECONDS=60

# Auth
# Keep this value if you want the built-in Alice/Bob demo tokens to work out of the box.
JWT_SHARED_SECRET=your-super-secret-jwt-key-here
AUTH_SUB_CLAIM=sub
AUTH_NAME_CLAIM=name
AUTH_AVATAR_CLAIM=avatarUrl
AUTH_ROLE_CLAIM=role
AUTH_ROLE_AUTHORIZATION_ENABLED=false

# Uploads and assets
# Local default: repo-relative storage paths.
# Docker default: docker-compose overrides these to /app/storage/assets...
UPLOAD_PATH=storage/assets/chat/uploads
ASSETS_PATH=storage/assets
UPLOAD_MAX_FILE_SIZE_BYTES=52428800

# Feature flags
FEATURE_CHAT=true
FEATURE_UPLOADS=true
FEATURE_PRESENCE=true
FEATURE_CALLS=true

# RTC / WebRTC
# STUN is usually enough for same-machine or same-network testing.
# Add TURN values for broader real-world connectivity.
RTC_STUN_URLS=stun:stun.l.google.com:19302
RTC_TURN_URLS=
RTC_TURN_USERNAME=
RTC_TURN_PASSWORD=
RTC_ICE_TRANSPORT_POLICY=all

# Socket.IO admin UI
# Recommended for local troubleshooting only.
SOCKET_ADMIN_ENABLED=false
SOCKET_ADMIN_AUTH_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Dev tooling
# Optional. Only needed for npm run tunnel:dev
NGROK_AUTHTOKEN=
